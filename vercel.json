{
  "version": 2,
  "buildCommand": "npm install --include=optional && npm install pg@latest",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/ping",
      "dest": "/api/ping.js"
    },
    {
      "src": "/minimal",
      "dest": "/api/minimal.js"
    },
    {
      "src": "/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "public": false
}
