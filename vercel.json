{
  "version": 2,
  "buildCommand": "npm ci --legacy-peer-deps || npm install",
  "installCommand": "npm install --legacy-peer-deps || npm install",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/ping",
      "dest": "/api/ping.js"
    },
    {
      "src": "/minimal",
      "dest": "/api/minimal.js"
    },
    {
      "src": "/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
